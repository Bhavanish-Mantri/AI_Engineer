# ── Copy this to .env and fill in ONE llm key. Nothing else is required. ──

# Free key from https://console.groq.com/keys
GROQ_API_KEY=

# ...or a free key from https://aistudio.google.com/apikey
# (Gemini's free tier is more generous than Groq's)
GEMINI_API_KEY=


# ── Everything below is optional ─────────────────────────────────────────

# Leave these blank and the vector index lives in a local folder
# (~/.ytrag/qdrant). Only set them if you want a hosted Qdrant cluster.
QDRANT_URL=
QDRANT_API_KEY=

# groq | gemini | none   (auto-detected from whichever key you set above)
# YTRAG_LLM_BACKEND=

# Smaller + faster embedding model, if bge-m3 (2.2GB) is too heavy for your
# machine. Slightly worse on Hinglish, runs anywhere.
# YTRAG_EMBED_MODEL=all-MiniLM-L6-v2
